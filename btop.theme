# ────────────────────────────────────────────────────────────
# btop theme - Norman Bii (Matrix-style green on black)
# forked from Omarchy Matte Black by tahayvr
# ────────────────────────────────────────────────────────────

# Colors should be in 6 or 2 character hexadecimal or single spaced rgb decimal: "#RRGGBB", "#BW" or "0-255 0-255 0-255"
# example for white: "#ffffff", "#ff" or "255 255 255".

# All graphs and meters can be gradients
# For single color graphs leave "mid" and "end" variable empty.
# Use "start" and "end" variables for two color gradient
# Use "start", "mid" and "end" for three color gradient

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]=""

# Main text color
theme[main_fg]="#7cff9b"

# Title color for boxes
theme[title]="#1f9d33"

# Highlight color for keyboard shortcuts
theme[hi_fg]="#30d158"

# Background color of selected item in processes box
theme[selected_bg]="#30d158"

# Foreground color of selected item in processes box
theme[selected_fg]="#000000"

# Color of inactive/disabled text
theme[inactive_fg]="#0d3b14"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="#1f9d33"

# Cpu box outline color
theme[cpu_box]="#1f9d33"

# Memory/disks box outline color
theme[mem_box]="#1f9d33"

# Net up/down box outline color
theme[net_box]="#1f9d33"

# Processes box outline color
theme[proc_box]="#1f9d33"

# Box divider line and small boxes line color
theme[div_line]="#1f9d33"

# Temperature graph colors
theme[temp_start]="#0d3b14"
theme[temp_mid]="#1f9d33"
theme[temp_end]="#7cff9b"

# CPU graph colors
theme[cpu_start]="#0d3b14"
theme[cpu_mid]="#1f9d33"
theme[cpu_end]="#7cff9b"

# Mem/Disk free meter
theme[free_start]="#0d3b14"
theme[free_mid]="#1f9d33"
theme[free_end]="#7cff9b"

# Mem/Disk cached meter
theme[cached_start]="#0d3b14"
theme[cached_mid]="#1f9d33"
theme[cached_end]="#7cff9b"

# Mem/Disk available meter
theme[available_start]="#0d3b14"
theme[available_mid]="#1f9d33"
theme[available_end]="#7cff9b"

# Mem/Disk used meter
theme[used_start]="#0d3b14"
theme[used_mid]="#1f9d33"
theme[used_end]="#7cff9b"

# Download graph colors
theme[download_start]="#0d3b14"
theme[download_mid]="#1f9d33"
theme[download_end]="#7cff9b"

# Upload graph colors
theme[upload_start]="#0d3b14"
theme[upload_mid]="#1f9d33"
theme[upload_end]="#7cff9b"
